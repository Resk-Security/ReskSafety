# RESK Production Configuration
# Copy to .env and fill in secrets
# docker compose --env-file .env up -d

# ── Secrets (MANDATORY — generate strong random values) ──
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string
CSRF_SECRET=change-me-to-another-random-string
PROVIDER_ENCRYPTION_KEY=change-me-to-32-byte-base64-key

# ── LLM Backend ──
LLM_BACKEND_TYPE=openai
LLM_BACKEND_URL=https://api.openai.com/v1
LLM_BACKEND_API_KEY=sk-your-api-key
LLM_DEFAULT_MODEL=gpt-4o-mini

# ── Anthropic (optional, for /v1/messages endpoint) ──
ANTHROPIC_API_KEY=

# ── Database (default: PostgreSQL via docker-compose) ──
DB_PASSWORD=reskpass

# ── CORS ──
CORS_ORIGINS=http://localhost:3000,https://resk.yourdomain.com

# ── Security ──
LOG_PROMPTS=false
RATE_LIMIT_PER_MINUTE=60
RESK2_ENABLED=false

# ── reskPoints (optional, for agent session tracking) ──
RESKPOINTS_API_KEY=
