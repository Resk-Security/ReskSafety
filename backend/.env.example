# Core
DATABASE_URL=sqlite:///./resk.db
LOG_LEVEL=INFO

# Auth
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=7

# CSRF
CSRF_SECRET=change-me-csrf-secret

# Cookies
COOKIE_SECURE=false

# LLM backend (DeepSeek par défaut — compatible OpenAI)
LLM_BACKEND_TYPE=openai
LLM_BACKEND_URL=https://api.deepseek.com/v1
LLM_BACKEND_API_KEY=
LLM_DEFAULT_MODEL=deepseek-chat

# Provider encryption
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: must be set in production — a missing/empty key allows trivial decryption of stored provider API keys
PROVIDER_ENCRYPTION_KEY=

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_PROMPTS=false

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# RESK-LLM (resk2) middleware - disabled by default
RESK2_ENABLED=false
